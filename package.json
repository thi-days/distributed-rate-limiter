{
  "name": "distributed-rate-limiter",
  "version": "1.0.0",
  "description": "A system design case study exploring distributed rate limiting.",
  "license": "ISC",
  "author": "Thiago Dias",
  "type": "commonjs",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/tests/unit/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test .test-dist/tests/integration/*.test.js"
  },
  "private": true,
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "redis": "^6.3.0"
  }
}
